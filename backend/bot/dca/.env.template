# ============================================
# CONFIGURATION API BINANCE
# ============================================
# ⚠️ IMPORTANT: NEVER commit this file with your real keys!
# Create a .env file from this template and add your keys.

# Binance API keys (REQUIRED)
# Get your keys at: https://www.binance.com/en/my/settings/api-management
# Required permissions: Enable Spot & Margin Trading, Enable Reading
BINANCE_API_KEY=your_api_key_here
BINANCE_API_SECRET=your_api_secret_here

# ============================================
# DCA CONFIGURATION (Dollar Cost Averaging)
# ============================================

# Fixed amount in USDC to invest per purchase
DCA_AMOUNT_USDC=30.0

# Trading pair symbol (default: ETHUSDC)
DCA_SYMBOL=ETHUSDC

# Base asset (what we buy)
DCA_BASE_ASSET=ETH

# Quote asset (what we spend)
DCA_QUOTE_ASSET=USDC

# Days of month for execution (comma-separated, e.g., "1,15" for 1st and 15th)
# This is the RECOMMENDED method for reliable scheduling
# Missed executions will run on next startup if within 7 days of scheduled time
# Examples:
#   "1,15" = Execute on 1st and 15th of each month (bi-monthly)
#   "1" = Execute on 1st of each month (monthly)
#   "1,8,15,22" = Execute every ~week on specific days
DCA_DAYS_OF_MONTH=1,15

# Execution hour (24h format)
DCA_EXECUTION_HOUR=10

# Execution minute
DCA_EXECUTION_MINUTE=2

# Base PRUM (Optional)
# Set this to your known average purchase price from historical purchases
# Example: If you bought 0.04149715 ETH for 98.10 EUR, that's ~2364 EUR/ETH
# Leave commented out if you want to start fresh (only track bot purchases)
# DCA_BASE_PRUM=2364.0

# Base Quantity (Optional)
# Set this to the quantity you already own from historical purchases
# Used together with DCA_BASE_PRUM for accurate PRUM calculation
# DCA_BASE_QUANTITY=0.04149715

# ============================================
# STRATEGY PARAMETERS (Optional - Advanced)
# ============================================

# Buffer above PRUM to avoid frequent skips (default: 0.03 = 3%)
# The bot will skip purchases when price > PRUM * (1 + buffer)
# DCA_PRUM_BUFFER=0.03

# Number of historical periods to analyze for momentum (default: 2)
# The bot skips purchases when all N periods are bullish AND price > PRUM
# DCA_MOMENTUM_PERIODS=2

# Kline interval for momentum analysis (default: 1w)
# Valid values: 1d, 3d, 1w, 1M
# DCA_KLINE_INTERVAL=1w

# ============================================
# DATABASE CONFIGURATION
# ============================================

# PostgreSQL connection string (REQUIRED)
# Format: postgresql://username:password@host:port/database
# Example: postgresql://romeo:postgres@localhost:8400/stock_alerting
POSTGRESQL_CONNECTION_STRING=postgresql://romeo:postgres@localhost:8400/stock_alerting

# ============================================
# EMAIL NOTIFICATIONS
# ============================================

# SMTP server settings
SMTP_USER=your_email@gmail.com
SMTP_PASSWORD=your_app_password_here

# Email addresses
EMAIL_TO=your_email@gmail.com

# Total strategy duration of the DCA strategy in months
DCA_DURATION_MONTHS=12

# Price thresholds to execute purchases
DCA_MINIMUM_BASE=100.0
DCA_MAXIMUM_BASE=1000.0