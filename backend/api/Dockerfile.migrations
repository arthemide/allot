FROM python:3.12-slim

ENV UV_VERSION=0.5.28

# Install uv
RUN pip install uv==$UV_VERSION

# Install build dependencies
RUN apt-get update \
    && apt-get install -y \
    build-essential \
    python3-dev \
    gcc \
    && apt-get clean \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /app

# Copy workspace root pyproject.toml to maintain workspace structure
COPY pyproject.toml /app/

# Copy shared package (workspace member)
COPY shared /app/shared

# Copy API files and lock
COPY api/pyproject.toml /app/api/
COPY uv.lock /app/

# Install dependencies using workspace
RUN cd /app/api && uv sync --frozen --only-group migration

# Copy Alembic configuration and migrations to /app/api
COPY api/alembic.ini /app/api/
COPY api/alembic /app/api/alembic

WORKDIR /app/api

CMD ["uv", "run", "alembic"]