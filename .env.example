ALLOT_VERSION=latest

# Port the app is published on, on the host.
ALLOT_PORT=8000

# --- Authentication ----------------------------------------------------
# Empty: the app is open to whoever can reach it, which is the LAN default.
# Filled in: the API only answers a browser that has logged in. Required
# before putting the app on a domain. See the README for how to generate both.
# Changing the key logs every browser out.
ALLOT_PASSWORD_HASH=
ALLOT_SECRET_KEY=

# The cookie is reissued on every request, so this counts from the last visit.
ALLOT_SESSION_DAYS=30

# Set to 0 to reach a password-protected instance over plain HTTP.
ALLOT_COOKIE_SECURE=1

# Proxies allowed to state the real client address, which the rate limit on
# the Yahoo-facing endpoints keys on.
ALLOT_FORWARDED_ALLOW_IPS=127.0.0.1

# --- Off-site replication (Litestream) ---------------------------------
# Continuous replication of the database to Scaleway Object Storage. Leave
# LITESTREAM_BUCKET empty to keep everything local.
#
# Create the bucket and an API key in the Scaleway console; the secret key is
# shown once, at creation. The endpoint and the region have to agree:
# https://s3.<region>.scw.cloud, with fr-par, nl-ams or pl-waw.
LITESTREAM_BUCKET=
LITESTREAM_ENDPOINT=s3.fr-par.scw.cloud
LITESTREAM_REGION=fr-par
LITESTREAM_ACCESS_KEY_ID=
LITESTREAM_SECRET_ACCESS_KEY=
